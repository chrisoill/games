    function handleHoldStart() {
      if (castState === "count") {
        inputHeld = true;
        queuedEarlyCast = true;
        return;
      }

      if (castState === "ready") {
        inputHeld = true;
        beginCast();
        return;
      }

      if (castState === "holding") {
        inputHeld = true;
      }
    }

    function handleHoldEnd() {
    if (castState === "count") {
      inputHeld = false;
      queuedEarlyCast = false;
      return;
    }

    if (castState === "ready") {
      inputHeld = false;
      queuedEarlyCast = false;
      return;
    }

    if (castState === "casting") {
      inputHeld = false;
      queuedEarlyCast = false;
      releaseCast({ air: true });
      return;
    }

    if (castState === "holding") {
      inputHeld = false;
      releaseCast();
      return;
    }

    inputHeld = false;
    queuedEarlyCast = false;
  }

    function releaseCast(options = {}) {
    if (castState !== "holding" && castState !== "casting") return;

    const t = nowMs();
    heldMs = Math.max(0, t - castStartedAt);
    missMs = Math.round(Math.abs(heldMs - TARGET_HOLD_MS));
    timingDirection = getTimingDirection(heldMs);
    resultKind = options.air ? "air" : "catch";
    resultText = resultKind === "air" ? "Air!" : getCatchName(missMs);
    setScore(missMs);
    if (!releaseSoundPlayed) {
      soundReleaseTug();
      releaseSoundPlayed = true;
    }

    castState = "reveal";
    stateStartedAt = t;
    ui(`${resultText} — ${timingDetailText()}`);
  }

    function gameInit() {
      resetJoystick(sticks.left);
      resetJoystick(sticks.right);
      updateShellMenuTab("instructions", `
        <h3>How to Play</h3>
        <ul>
          <li>Wait for the 1-2-3 count-in.</li>
          <li>Hold CAST, or hold the lake screen, to cast your line.</li>
          <li>Release when you think exactly 20 seconds have passed.</li>
          <li>Your score is how many milliseconds you were off, so lower is better.</li>
          <li>The closer you are to perfect, the better the catch.</li>
        </ul>
        <p>You can restart the attempt before releasing if you know your timing is already off.</p>
      `);
      resetCastRun();
    }

    function gameUpdate() {
    const t = nowMs();

    if (castState === "count") {
      const elapsed = t - stateStartedAt;
      const remaining = Math.max(1, 3 - Math.floor(elapsed / COUNT_BEAT_MS));

      if (elapsed >= COUNT_BEAT_MS * 3) {
        castState = "ready";
        stateStartedAt = t;

        if (inputHeld && queuedEarlyCast) {
          beginCast(t);
        } else {
          ui("");
        }
      } else {
        if (remaining !== lastCountdownNumber) {
          lastCountdownNumber = remaining;
          soundCountdownClick(remaining);
        }
        ui(`Cast in ${remaining}`);
      }
    }

    if (castState === "ready") {
      ui("");
    }

    if (castState === "casting") {
      const elapsed = t - stateStartedAt;
      heldMs = Math.max(0, t - castStartedAt);

      if (!inputHeld) {
        releaseCast({ air: true });
      } else if (elapsed >= CAST_ANIM_MS) {
        if (!bobberSplashPlayed) {
          soundBobberSplash();
          bobberSplashPlayed = true;
        }
        castState = "holding";
        stateStartedAt = t;
        ui("Release on 20 seconds");
      } else {
        ui(SHOW_DEBUG_TIMER ? `Casting ${secondsText(heldMs)} — release at 20 seconds` : "Release on 20 seconds");
      }
    }

    if (castState === "holding") {
      heldMs = t - castStartedAt;
      ui(SHOW_DEBUG_TIMER ? `Holding ${secondsText(heldMs)} — release at 20 seconds` : "Release on 20 seconds");
    }

    if (castState === "reveal") {
      const elapsed = t - stateStartedAt;
      const revealProgress = Math.min(1, elapsed / REVEAL_MS);
      const revealThreshold = 0.78;
      if (!revealSoundPlayed && revealProgress >= revealThreshold) {
        revealSoundPlayed = true;
        soundCatchReveal(getFinalRevealSoundKind(), getCatchQuality(missMs));
      }
      if (!revealSaved && elapsed >= REVEAL_MS) {
        revealSaved = true;
        endGame(`${resultText}. ${timingDetailText()}.`);
      }
    }
  }

    
  function drawSky(w, h, lakeY, t) {
