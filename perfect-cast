    function beginCast(startTime = nowMs()) {
    if (castState !== "ready" && castState !== "count") return;
    castState = "casting";
    stateStartedAt = startTime;
    castStartedAt = startTime;
    heldMs = 0;
    missMs = null;
    resultText = "";
    resultKind = "catch";
    timingDirection = "";
