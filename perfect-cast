      ctx.fillRect(-bw * 0.03, -bh * 0.86, bw * 0.10, bh * 0.20);
      ctx.fillStyle = '#dbeafe';
      ctx.fillRect(-bw * 0.43, bh * 0.18, bw * 0.52, bh * 0.18);
      ctx.fillRect(-bw * 0.26, bh * 0.02, bw * 0.12, bh * 0.08);
      ctx.fillStyle = '#93c5fd';
      ctx.fillRect(-bw * 0.04, -bh * 0.80, bw * 0.05, bh * 0.16);
      ctx.fillRect(bw * 0.08, -bh * 0.10, bw * 0.16, bh * 0.06);
      eye(-bw * 0.41, -bh * 0.16, 1.2);
      ctx.restore();
      return;
    }

    if (name === 'Orca' || name.includes('Shark')) {
      const bw = size * 2.02;
      const bh = size * 0.58;
      ctx.fillStyle = name === 'Orca' ? '#111827' : '#64748b';
      ctx.fillRect(-bw * 0.48, -bh * 0.42, bw * 0.82, bh);
      ctx.fillRect(bw * 0.22, -bh * 0.12, bw * 0.30, bh * 0.24);
      ctx.fillRect(bw * 0.42, -bh * 0.35, bw * 0.18, bh * 0.19);
      ctx.fillRect(bw * 0.42, bh * 0.16, bw * 0.18, bh * 0.19);
      ctx.fillRect(-bw * 0.10, -bh * 0.84, bw * 0.20, bh * 0.42);
      ctx.fillStyle = name === 'Orca' ? '#f8fafc' : '#cbd5e1';
      ctx.fillRect(-bw * 0.31, bh * 0.13, bw * 0.40, bh * 0.17);
      ctx.fillRect(-bw * 0.14, -bh * 0.04, bw * 0.16, bh * 0.05);
      eye(-bw * 0.38, -bh * 0.15);
      ctx.restore();
      return;
    }

    if (name === 'Giant Squid' || name === 'Octopus') {
      const bw = size * 0.98;
      const bh = size * 0.94;
      ctx.fillStyle = name === 'Giant Squid' ? '#a855f7' : '#c2410c';
      ctx.fillRect(-bw * 0.35, -bh * 0.46, bw * 0.70, bh * 0.64);
      ctx.fillRect(-bw * 0.22, -bh * 0.68, bw * 0.44, bh * 0.25);
      ctx.fillStyle = 'rgba(255,255,255,0.22)';
      ctx.fillRect(-bw * 0.14, -bh * 0.54, bw * 0.16, bh * 0.10);
      ctx.strokeStyle = name === 'Giant Squid' ? '#7e22ce' : '#9a3412';
      ctx.lineWidth = Math.max(2, unit * 2);
      for (let i = -3; i <= 3; i++) {
        ctx.beginPath();
        ctx.moveTo(i * bw * 0.09, bh * 0.10);
        ctx.lineTo(i * bw * 0.12 + Math.sin(nowMs() / 160 + i) * unit * 3, bh * 0.58);
        ctx.stroke();
      }
      eye(-bw * 0.16, -bh * 0.25);
      eye(bw * 0.10, -bh * 0.25);
      ctx.restore();
      return;
    }

    if (['Lobster', 'Crab', 'Clam', 'Shrimp'].includes(name)) {
      const bw = size * 1.08;
      const bh = size * 0.50;
      ctx.fillStyle = name === 'Clam' ? '#d6b48c' : '#e85d3f';
      ctx.fillRect(-bw * 0.38, -bh * 0.35, bw * 0.76, bh * 0.70);
      ctx.fillStyle = name === 'Clam' ? '#e7c9a8' : '#b53a2a';
      if (name !== 'Clam') {
        ctx.fillRect(-bw * 0.58, -bh * 0.20, bw * 0.18, bh * 0.18);
        ctx.fillRect(bw * 0.40, -bh * 0.20, bw * 0.18, bh * 0.18);
        ctx.fillRect(-bw * 0.32, bh * 0.33, bw * 0.12, bh * 0.24);
        ctx.fillRect(bw * 0.20, bh * 0.33, bw * 0.12, bh * 0.24);
        ctx.fillRect(-bw * 0.10, -bh * 0.52, bw * 0.10, bh * 0.18);
      } else {
        ctx.fillRect(-bw * 0.28, -bh * 0.08, bw * 0.56, bh * 0.08);
      }
      ctx.restore();
      return;
    }

    const bw = size * 1.56;
    const bh = size * 0.67;
    ctx.fillStyle = name === 'Swordfish' ? '#60a5fa' : name === 'Tuna' ? '#2563eb' : name === 'Salmon' ? '#fb7185' : name === 'Bass' ? '#84cc16' : '#f59e0b';
    ctx.fillRect(-bw * 0.42, -bh * 0.42, bw * 0.72, bh * 0.84);
    ctx.fillStyle = 'rgba(255,255,255,0.20)';
    ctx.fillRect(-bw * 0.18, -bh * 0.24, bw * 0.20, bh * 0.10);
    ctx.fillStyle = '#0f766e';
    ctx.fillRect(bw * 0.24, -bh * 0.24, bw * 0.28, bh * 0.20);
    ctx.fillRect(bw * 0.24, bh * 0.04, bw * 0.28, bh * 0.20);
    ctx.fillRect(-bw * 0.06, -bh * 0.66, bw * 0.18, bh * 0.22);
    if (name === 'Swordfish') {
      ctx.fillStyle = '#dbeafe';
      ctx.fillRect(-bw * 0.78, -unit * 1.4, bw * 0.38, unit * 3);
    }
    eye(-bw * 0.33, -bh * 0.14);
    ctx.restore();
  }

  function isAirResult() {
    return resultKind === 'air' || resultText === 'Air!';
  }

  function drawAirCatch(x, y, unit, p) {
    const pulse = 1 + Math.sin(nowMs() / 90) * 0.04;
    const alpha = 0.82 * (1 - clamp01(p) * 0.18);
    ctx.save();
    ctx.translate(x, y - unit * 8 * clamp01(p));
    ctx.scale(pulse, pulse);

    ctx.strokeStyle = `rgba(255,255,255,${alpha})`;
    ctx.lineWidth = Math.max(2, unit * 1.8);
    ctx.setLineDash([unit * 5, unit * 4]);
    ctx.beginPath();
    ctx.ellipse(0, 0, unit * 24, unit * 14, -0.18, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = `rgba(255,255,255,${0.65 * alpha})`;
    ctx.fillRect(-unit * 12, -unit * 4, unit * 7, unit * 5);
    ctx.fillRect(-unit * 2, -unit * 8, unit * 10, unit * 6);
    ctx.fillRect(unit * 8, -unit * 2, unit * 8, unit * 5);
    ctx.strokeStyle = 'rgba(255,255,255,0.40)';
    ctx.strokeRect(-unit * 16, unit * 12, unit * 32, unit * 12);

    ctx.fillStyle = 'rgba(16,32,51,0.82)';
    ctx.font = `bold ${Math.max(10, unit * 13)}px Arial, sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('AIR!', 0, unit * 21);
    ctx.restore();
  }

  function drawCaughtThing(x, y, unit, p) {
    if (isAirResult()) {
      drawAirCatch(x, y, unit, p);
    } else if (missMs !== null && missMs > VALID_WINDOW_MS) {
      drawSeaweedCatch(x, y, unit, p);
    } else {
      drawFishCatch(x, y, unit, p);
    }
  }

  
  function drawBoat(w, h, lakeY, t) {
    const unit = Math.max(1, Math.min(w / 390, h / 219));
    const revealP = getRevealProgress();
    const castP = getCastProgress();
    const casting = castState === 'casting';
    const holding = castState === 'holding';
    const revealing = castState === 'reveal';
    const airResult = isAirResult();
    const badCatch = !airResult && missMs !== null && missMs > VALID_WINDOW_MS;
    const catchQuality = missMs === null ? 0.5 : getCatchQuality(missMs);
    const heavyCatch = !airResult && !badCatch && catchQuality > 0.72;

    const struggle = revealing ? Math.max(0, 1 - revealP / 0.42) : 0;
    const boatRockBase = Math.sin(t * 1.17) * unit * 2.1;

    let windBack = 0;
    let castSnap = 0;
    if (casting) {
      windBack = clamp01(castP / 0.18);
      castSnap = clamp01((castP - 0.16) / 0.46);
    }
    const castPrep = Math.sin(windBack * Math.PI * 0.5);
    const castRelease = Math.sin(clamp01(castSnap) * Math.PI);
    const castFollow = casting ? Math.sin(clamp01((castP - 0.48) / 0.52) * Math.PI) : 0;

    const struggleWhip = struggle * Math.sin(t * 28) * unit * 4.8;
    const tug = struggle * Math.sin(t * 34) * unit * 3.8;
    const boatX = w * 0.27 + tug * 0.50;
    const boatY = lakeY + h * 0.18 + boatRockBase + struggle * Math.sin(t * 14) * unit * 1.4;
    const boatW = w * 0.31;
    const boatH = h * 0.082;
    const hookX = w * 0.70 + tug * 0.95;
    const hookY = lakeY + h * 0.245 + Math.sin(t * 1.55) * unit * 2.2;

    ctx.fillStyle = 'rgba(8,44,67,0.20)';
    ctx.fillRect(boatX - boatW * 0.48, boatY + boatH * 0.86, boatW * 0.94, Math.max(4, unit * 3));
    ctx.fillStyle = 'rgba(255,255,255,0.10)';
    ctx.fillRect(boatX - boatW * 0.46, boatY + boatH * 1.02, boatW * 0.75, Math.max(2, unit * 2));

    ctx.fillStyle = '#6a3d1c';
    ctx.beginPath();
    ctx.moveTo(boatX - boatW * 0.52, boatY);
    ctx.lineTo(boatX + boatW * 0.50, boatY);
    ctx.lineTo(boatX + boatW * 0.35, boatY + boatH);
    ctx.lineTo(boatX - boatW * 0.42, boatY + boatH);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#9d5d2a';
    ctx.fillRect(boatX - boatW * 0.31, boatY + boatH * 0.12, boatW * 0.60, boatH * 0.18);
    ctx.fillStyle = '#c78647';
    ctx.fillRect(boatX - boatW * 0.48, boatY + boatH * 0.08, boatW * 0.94, boatH * 0.08);
    ctx.fillStyle = '#4a2a18';
    ctx.fillRect(boatX - boatW * 0.42, boatY + boatH * 0.60, boatW * 0.78, Math.max(2, unit * 2));
    ctx.fillRect(boatX - boatW * 0.10, boatY + boatH * 0.28, boatW * 0.14, boatH * 0.22);
    ctx.fillStyle = '#7f5327';
    ctx.fillRect(boatX - boatW * 0.38, boatY + boatH * 0.20, boatW * 0.09, boatH * 0.42);
    ctx.fillStyle = '#3b2315';
    ctx.fillRect(boatX + boatW * 0.12, boatY + boatH * 0.24, boatW * 0.08, boatH * 0.46);
    ctx.fillStyle = '#bcd7e7';
    ctx.fillRect(boatX + boatW * 0.16, boatY + boatH * 0.18, boatW * 0.06, boatH * 0.10);

    const bodyLean = casting
      ? (-unit * 5.2 * castPrep + unit * 8.2 * castRelease - unit * 2.2 * castFollow)
      : revealing
      ? (-unit * 5.5 * struggle + unit * 1.2 * revealP)
      : Math.sin(t * 1.3) * unit * 0.8;
    const armLift = casting ? (-unit * 3.2 * castPrep + unit * 6.2 * castRelease) : revealing ? unit * 2.2 * struggle : unit * 0.6;

    const fx = boatX - boatW * 0.08 - tug * 0.2;
    const fy = boatY - boatH * 0.18 + tug * 0.1;

    ctx.fillStyle = '#314560';
    ctx.fillRect(fx - unit * 5.5 + bodyLean * 0.18, fy - unit * 3.0, unit * 12, unit * 15);
    ctx.fillStyle = '#24364b';
    ctx.fillRect(fx - unit * 3.5 + bodyLean * 0.15, fy + unit * 5, unit * 8, unit * 8);
    ctx.fillStyle = '#f1bf86';
    ctx.fillRect(fx - unit * 4.5 + bodyLean * 0.14, fy - unit * 12, unit * 10, unit * 9);
    ctx.fillStyle = '#d69b2d';
    ctx.fillRect(fx - unit * 7 + bodyLean * 0.16, fy - unit * 15, unit * 16, unit * 4);
    ctx.fillRect(fx - unit * 3 + bodyLean * 0.16, fy - unit * 19, unit * 9, unit * 4);
    ctx.fillStyle = '#8b5a2b';
    ctx.fillRect(fx - unit * 5 + bodyLean * 0.18, fy - unit * 2, unit * 3, unit * 7);
    ctx.fillStyle = '#1f2937';
    ctx.fillRect(fx - unit * 8, fy + unit * 8, unit * 11, unit * 4);
    ctx.fillRect(fx + unit * 4, fy + unit * 8, unit * 12, unit * 4);
    ctx.fillStyle = '#111827';
    ctx.fillRect(fx - unit * 1.2, fy - unit * 10.2, unit * 1.3, unit * 1.3);
    ctx.fillStyle = '#ef4444';
    ctx.fillRect(fx + unit * 2.7, fy - unit * 10.1, unit * 1.4, unit * 1.4);

    const rodStartX = fx + unit * 7 + bodyLean * 0.25;
    const rodStartY = fy - unit * 3 - armLift * 0.20;
    let rodEndX = boatX + boatW * 0.41;
    let rodEndY = boatY - boatH * 1.28;
    if (casting) {
      rodEndX += -unit * 12 * castPrep + unit * 19 * castRelease - unit * 3 * castFollow;
      rodEndY += unit * 10 * castPrep - unit * 21 * castRelease + unit * 7 * castFollow;
    } else if (revealing) {
      rodEndX += -unit * 6.8 * struggle + unit * 3.0 * revealP;
      rodEndY += -unit * 12.5 * struggle + unit * 4.5 * revealP + struggleWhip * 0.18;
    } else if (holding) {
      rodEndX += Math.sin(t * 1.4) * unit * 1.2;
      rodEndY += Math.sin(t * 2.1) * unit * 1.4;
    }

    ctx.strokeStyle = '#3b2414';
    ctx.lineWidth = Math.max(2, unit * 2.1);
    ctx.beginPath();
    ctx.moveTo(rodStartX, rodStartY);
    ctx.lineTo(rodEndX, rodEndY);
    ctx.stroke();
    ctx.fillStyle = '#2c1a12';
    ctx.fillRect(rodStartX - unit * 2.5, rodStartY - unit * 1.5, unit * 4.5, unit * 3);
    ctx.fillStyle = '#c9d3dc';
    ctx.fillRect(rodStartX - unit * 1.2, rodStartY + unit * 1.2, unit * 3.1, unit * 3.1);
    ctx.fillStyle = '#1f130b';
    ctx.fillRect(rodEndX - unit * 1.3, rodEndY - unit * 1.3, unit * 2.6, unit * 2.6);

    function drawLineTo(x, y, alpha = 0.84, widthBoost = 1) {
      ctx.strokeStyle = `rgba(20,30,38,${alpha})`;
      ctx.lineWidth = Math.max(1, unit * widthBoost);
      ctx.beginPath();
      ctx.moveTo(rodEndX, rodEndY);
      ctx.lineTo(x, y);
      ctx.stroke();
    }

    if (casting) {
      const p = easeOutCubic(castP);
      const bobX = lerp(rodEndX, hookX, p);
      const bobY = lerp(rodEndY + unit * 4, hookY, p) - Math.sin(castP * Math.PI) * h * 0.24;
      ctx.strokeStyle = 'rgba(20,30,38,0.62)';
      ctx.lineWidth = Math.max(1, unit);
      ctx.beginPath();
      ctx.moveTo(rodEndX, rodEndY);
      ctx.quadraticCurveTo(lerp(rodEndX, hookX, 0.46), Math.min(rodEndY, hookY) - h * 0.18, bobX, bobY);
      ctx.stroke();
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(bobX - unit * 3, bobY - unit * 3, unit * 6, unit * 6);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(bobX - unit * 3, bobY - unit * 3, unit * 6, unit * 3);
      if (castP > 0.82) {
        const splashP = clamp01((castP - 0.82) / 0.18);
        ctx.strokeStyle = 'rgba(255,255,255,0.55)';
        ctx.lineWidth = Math.max(1, unit);
        ctx.beginPath();
        ctx.ellipse(hookX, hookY + unit * 3, unit * (5 + 8 * splashP), unit * (2 + 3 * splashP), 0, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    if (holding) {
      const driftX = Math.sin(t * 0.9) * unit * 1.6;
      const driftY = Math.sin(t * 1.2) * unit * 0.8;
      drawLineTo(hookX + driftX * 0.15, hookY + driftY, 0.74, 1);
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(hookX - unit * 3 + driftX, hookY - unit * 3 + driftY, unit * 6, unit * 6);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(hookX - unit * 3 + driftX, hookY - unit * 3 + driftY, unit * 6, unit * 3);
      ctx.strokeStyle = 'rgba(255,255,255,0.42)';
      ctx.lineWidth = Math.max(1, unit);
      ctx.beginPath();
      ctx.ellipse(hookX + driftX, hookY + unit * 3 + driftY * 0.2, unit * 10, unit * 3.5, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.beginPath();
      ctx.ellipse(hookX + driftX, hookY + unit * 3 + driftY * 0.2, unit * 15, unit * 5.2, 0, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255,255,255,0.20)';
      ctx.stroke();
    }

    if (revealing) {
      const splashX = hookX;
      const splashY = lakeY + h * 0.245;
      const airCastP = clamp01(heldMs / CAST_ANIM_MS);
      const airX = lerp(rodEndX, hookX, easeOutCubic(airCastP));
      const airY = lerp(rodEndY + unit * 4, hookY, easeOutCubic(airCastP)) - Math.sin(airCastP * Math.PI) * h * 0.24;
      const struggleP = clamp01(revealP / 0.38);
      const launchStart = airResult ? 0.00 : heavyCatch ? 0.40 : badCatch ? 0.28 : 0.34;
      const launchDur = airResult ? 0.38 : heavyCatch ? 0.30 : 0.26;
      const popP = airResult ? clamp01(revealP / 0.38) : clamp01((revealP - launchStart) / launchDur);
      const throwP = easeOutCubic(popP);
      const retractP = easeInOutSine((revealP - 0.70) / 0.30);
      const catchSize = getCatchDisplaySize(missMs) * unit;
      const apexLift = h * (0.26 + Math.min(0.15, catchSize / Math.max(1, h) * 0.25));

      let caughtX = splashX + Math.sin(t * 10.5) * unit * 3 * (1 - popP * 0.35);
      let caughtY = splashY - unit * 4 - throwP * apexLift + retractP * h * 0.08;
      caughtX = lerp(caughtX, rodEndX + w * 0.12, retractP * 0.10);
      caughtY = lerp(caughtY, splashY - h * 0.19, retractP * 0.18);

      if (airResult) {
        caughtX = lerp(airX, airX + unit * 22, throwP * 0.35);
        caughtY = airY - unit * (8 + 28 * throwP) + retractP * unit * 18;
      }

      if (!airResult && !badCatch && revealP < launchStart) {
        const shadowP = easeInOutSine(struggleP);
        const shadowW = Math.max(unit * 16, catchSize * (0.42 + catchQuality * 0.18)) * shadowP;
        const shadowH = Math.max(unit * 5, shadowW * 0.22);
        ctx.fillStyle = `rgba(9,49,74,${0.28 + 0.18 * shadowP})`;
        ctx.beginPath();
        ctx.ellipse(splashX + Math.sin(t * 6.5) * unit * 3.5 * struggleP, splashY + unit * 10, shadowW, shadowH, 0, 0, Math.PI * 2);
        ctx.fill();
      }

      if (popP > 0.02) {
        drawLineTo(caughtX, caughtY, 0.90 - retractP * 0.25, 1.25);
      } else if (airResult) {
        drawLineTo(airX, airY, 0.72, 1);
      } else if (badCatch) {
        ctx.strokeStyle = 'rgba(20,30,38,0.72)';
        ctx.lineWidth = Math.max(1, unit);
        ctx.beginPath();
        ctx.moveTo(rodEndX, rodEndY);
        ctx.quadraticCurveTo(lerp(rodEndX, splashX, 0.5), lerp(rodEndY, splashY, 0.5) + unit * 12, splashX + tug * 0.2, splashY + tug * 0.6);
        ctx.stroke();
      } else {
        drawLineTo(splashX + tug * 0.2, splashY + tug * 0.6, 0.92, 1.35);
      }

      const splashPower = airResult ? 0 : Math.max(0.16, 1 - popP * 0.70) * (heavyCatch ? 1.25 : 1);
      ctx.strokeStyle = 'rgba(255,255,255,0.88)';
      ctx.lineWidth = Math.max(2, unit * 2);
      for (let i = 0; i < 9; i++) {
        const a = -Math.PI + i * Math.PI / 8;
        ctx.beginPath();
        ctx.moveTo(splashX, splashY);
        ctx.lineTo(
          splashX + Math.cos(a) * unit * (11 + 30 * revealP) * splashPower,
          splashY + Math.sin(a) * unit * (6 + 21 * revealP) * splashPower
        );
        ctx.stroke();
      }

      ctx.strokeStyle = 'rgba(255,255,255,0.48)';
      ctx.lineWidth = Math.max(1, unit);
      ctx.beginPath();
      ctx.ellipse(splashX, splashY + unit * 4, unit * (12 + 34 * revealP) * splashPower, unit * (4 + 9 * revealP) * splashPower, 0, 0, Math.PI * 2);
      ctx.stroke();

      if (badCatch && popP > 0.02) {
        ctx.save();
        ctx.translate(caughtX, caughtY);
        ctx.rotate(Math.sin(t * 6.5) * 0.08);
        drawCaughtThing(0, 0, unit, popP);
        ctx.restore();
      } else if (popP > 0.02) {
        drawCaughtThing(caughtX, caughtY, unit, popP);
      }
    }
  }



  function gameDraw() {
      const w = canvas.width;
      const h = canvas.height;
      const t = nowMs() / 1000;
      const lakeY = h * 0.52;

      ctx.clearRect(0, 0, w, h);
      drawSky(w, h, lakeY, t);
      drawMountains(w, h, lakeY);
      drawLake(w, h, lakeY, t);
      drawBoat(w, h, lakeY, t);

      let topText = "";
      let detailText = "";
      if (castState === "count") topText = lastUiText;
      if (castState === "casting" || castState === "holding") topText = SHOW_DEBUG_TIMER ? `Release at 20 seconds • ${secondsText(heldMs)}` : "Release on 20 seconds";
      if (castState === "reveal" && missMs !== null) {
        topText = resultText;
        detailText = timingDetailText();
      }

      if (topText) {
        const panelH = detailText ? 39 : 27;
        ctx.fillStyle = "rgba(255,255,255,0.76)";
        ctx.fillRect(8, 8, w - 16, panelH);
        ctx.fillStyle = "#102033";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.font = "bold 12px Arial, sans-serif";
        ctx.fillText(topText, w / 2, detailText ? 20 : 22);
        if (detailText) {
          ctx.font = "bold 10px Arial, sans-serif";
          ctx.fillText(detailText, w / 2, 35);
        }
      }
    }

    function gameInput(action) {
      if (action === "a" || action === "aDown") {
        handleHoldStart();
        return;
      }

      if (action === "aUp") {
        handleHoldEnd();
        return;
      }

      if (action === "b" || action === "select") {
        if (castState === "reveal") return;
        resetCastRun();
      }
    }

    function gameStop() {
      resetJoystick(sticks.left);
      resetJoystick(sticks.right);
      holdPointerId = null;
      inputHeld = false;
      queuedEarlyCast = false;
    }

    canvas.addEventListener("pointerdown", event => {
      if (!running) return;
      event.preventDefault();
      holdPointerId = event.pointerId;
      try { canvas.setPointerCapture(event.pointerId); } catch (err) {}
      gameInput("aDown");
    }, { passive: false });

    canvas.addEventListener("pointerup", event => {
      if (holdPointerId !== event.pointerId) return;
      event.preventDefault();
      holdPointerId = null;
      try {
        if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
      } catch (err) {}
      gameInput("aUp");
    }, { passive: false });

    canvas.addEventListener("pointercancel", event => {
      if (holdPointerId !== event.pointerId) return;
      holdPointerId = null;
      gameInput("aUp");
    });

    canvas.addEventListener("contextmenu", event => event.preventDefault());

    const resizeObserver = new ResizeObserver(() => {
      scaleAppToFrame();
      resetJoystick(sticks.left);
      resetJoystick(sticks.right);
      if (!running) gameDraw();
    });

    resizeObserver.observe(appFrame);

    window.addEventListener("orientationchange", () => {
      setTimeout(() => {
        scaleAppToFrame();
        resetJoystick(sticks.left);
        resetJoystick(sticks.right);
        if (!running) gameDraw();
      }, 250);
    });

    window.MobileArcadeShell = {
      canvas,
      ctx,
      sticks,
      setScore,
      addScore,
      setMessage,
      endGame,
      soundCorrect,
      soundWin,
      soundLose,
      getAudio,
      savePlayers,
      loadPlayers,
      openMenu: openShellMenu,
      maybeOpenFirstTimeHowToPlay: openFirstTimeHowToPlayBeforeStart,
      closeMenu: closeShellMenu,
      exitToPlayerMenu,
      saveCurrentScoreForSelectedPlayer,
      registerMenuTab: registerShellMenuTab,
      updateMenuTab: updateShellMenuTab
    };

    scaleAppToFrame();
    loadPlayers();
    resetJoystick(sticks.left);
    resetJoystick(sticks.right);
    gameInit();
    gameDraw();
  </script>
</body>
</html>
